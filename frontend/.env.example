# Google Maps JavaScript API key (restrict it to your domains in Google Cloud Console).
VITE_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers and cloud map styling. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Base URL of the FastAPI backend. Leave empty to call /api on the same origin.
VITE_API_BASE_URL=
# Set to "true" to use the built-in Paris sample instead of calling the backend.
VITE_USE_MOCK_API=false
# Supabase project URL and publishable key (sb_publishable_...), for sign-in. Both are safe in the browser.
# Leave empty to hide accounts and saving.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
